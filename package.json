{
  "name": "@graysonlang/viridis",
  "version": "1.2.0",
  "description": "The viridis colormap and its siblings (magma, plasma, inferno, cividis, turbo, mako, rocket) as a tiny dependency-free JavaScript library — perceptually uniform, colorblind-friendly color values for data visualization.",
  "keywords": [
    "viridis",
    "magma",
    "plasma",
    "inferno",
    "cividis",
    "turbo",
    "mako",
    "rocket",
    "colormap",
    "color",
    "colour",
    "palette",
    "matplotlib",
    "seaborn",
    "sequential",
    "perceptually-uniform",
    "dataviz",
    "visualization"
  ],
  "homepage": "https://github.com/graysonlang/viridis#readme",
  "bugs": {
    "url": "https://github.com/graysonlang/viridis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graysonlang/viridis.git"
  },
  "license": "CC0-1.0",
  "author": "Grayson Lang",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/viridis.d.ts",
      "default": "./src/viridis.js"
    }
  },
  "main": "./src/viridis.js",
  "types": "./src/viridis.d.ts",
  "files": [
    "src/viridis.js",
    "src/viridis.d.ts"
  ],
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "ports": "node ./scripts/build.mjs --print-port",
    "sync:launch": "node ./scripts/build.mjs --sync-launch",
    "build": "node ./scripts/build.mjs --lint --minify",
    "serve": "node ./scripts/build.mjs --lint --sourcemap --watch --serve --debug-port=auto",
    "dev": "npm run serve -- --proxy --launch",
    "vscode:build": "npm run build -- --vscode",
    "vscode:debug": "npm run serve -- --vscode",
    "lint": "biome check .",
    "test": "node --test",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@graysonlang/esp": "^2.1.0",
    "d3-delaunay": "^6.0.4",
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
